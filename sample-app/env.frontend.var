# ============================================================================
# FRONTEND: Hybrid Session Variable Mode
# ============================================================================
# Copy to .env.local in sample-app/
#
# Users log in via an Identity Provider. The backend uses a shared PAT and
# injects the tenant claim as a session variable. The frontend is the same
# OAuth login flow — the HYBRID distinction is entirely on the backend.
# ============================================================================

VITE_BACKEND_URL=http://localhost:3001
VITE_AUTH_MODE=OAUTH

# OAuth Authorization Endpoint (base URL, no query parameters)
VITE_OAUTH_LOGIN_URL=https://your-idp.example.com/oauth/authorize
VITE_OAUTH_CLIENT_ID=your_client_id
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Scope — include "openid" so the IdP returns an id_token for JWT validation
VITE_OAUTH_SCOPE=openid profile email

# Audience — must match IDP_AUDIENCE on the backend
# Required by some IdPs (e.g., Auth0) to return a JWT access_token
# VITE_OAUTH_AUDIENCE=your_audience

# Prompt — set to "login" during development to easily switch IdP accounts
# VITE_OAUTH_PROMPT=login
