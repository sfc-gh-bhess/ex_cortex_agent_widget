# ============================================================================
# BACKEND: Hybrid Role Mode
# ============================================================================
# Copy to .env in sample-app/
#
# Users authenticate via an Identity Provider. All Snowflake API calls use a
# shared service PAT. The tenant claim from the IdP JWT is mapped to a
# Snowflake role via a lookup table, and set via the X-Snowflake-Role header.
# Data access is controlled by Snowflake RBAC grants on the tenant role.
#
# Onboard new tenants by inserting rows in the mapping table — no restart.
# ============================================================================

SERVER_PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

AUTH_MODE=HYBRID
TENANT_ISOLATION_MODE=ROLE

# Thread tagging — max 8 characters (a per-user hash is appended automatically)
ORIGIN_APPLICATION=ask_crtx

# Snowflake
SNOWFLAKE_HOST=your_account.snowflakecomputing.com
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_PAT=your_personal_access_token

# Warehouse for SQL API queries against the tenant role mapping table
SNOWFLAKE_WAREHOUSE=YOUR_WH

# Role used to READ the mapping table (optional — defaults to the PAT user's role)
# This is NOT the per-tenant role; it is the admin role for reading the table.
# SNOWFLAKE_ROLE=YOUR_ROLE

# OAuth (from your Identity Provider)
OAUTH_TOKEN_URL=https://your-idp.example.com/oauth/token
OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# IdP JWT Validation
IDP_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json
IDP_ISSUER=https://your-idp.example.com
IDP_AUDIENCE=your_audience

# Tenant Configuration
# CLAIM_KEY: the JWT claim containing the tenant identifier (e.g., tenant, org_id)
CLAIM_KEY=tenant

# USERNAME_CLAIM_KEY: JWT claim for per-user thread scoping (default: email)
# USERNAME_CLAIM_KEY=email

# Tenant Role Mapping Table
# Fully-qualified table with columns: tenant_key VARCHAR, tenant_role VARCHAR
# Setup:
#   CREATE TABLE YOUR_DB.YOUR_SCHEMA.TENANT_ROLES (
#     tenant_key VARCHAR NOT NULL,
#     tenant_role VARCHAR NOT NULL
#   );
#   INSERT INTO YOUR_DB.YOUR_SCHEMA.TENANT_ROLES VALUES ('acme', 'TENANT_ACME');
TENANT_ROLE_TABLE=YOUR_DB.YOUR_SCHEMA.TENANT_ROLES

# Cache refresh interval in seconds (default: 300). Set to 0 to disable.
# On cache miss (new tenant), the table is re-fetched immediately regardless.
# TENANT_ROLE_CACHE_TTL_SECS=300
