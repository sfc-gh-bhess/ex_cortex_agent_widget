# ============================================================================
# FRONTEND: SSO (OAuth) Mode
# ============================================================================
# Copy to .env.local in sample-app/
#
# Users log in via an Identity Provider. Each user gets their own Snowflake
# session with per-user access control.
# ============================================================================

VITE_BACKEND_URL=http://localhost:3001
VITE_AUTH_MODE=OAUTH

# OAuth Authorization Endpoint (base URL, no query parameters)
VITE_OAUTH_LOGIN_URL=https://your-idp.example.com/oauth/authorize
VITE_OAUTH_CLIENT_ID=your_client_id
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Scope — request the scopes your IdP/Snowflake integration requires
# Example for Snowflake External OAuth: session:role-any
VITE_OAUTH_SCOPE=session:role-any

# Audience — required by some IdPs (e.g., Auth0) to return a JWT access_token
# VITE_OAUTH_AUDIENCE=https://your-api-identifier

# Prompt — set to "login" during development to easily switch IdP accounts
# VITE_OAUTH_PROMPT=login
