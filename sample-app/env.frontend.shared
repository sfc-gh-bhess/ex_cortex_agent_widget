# ============================================================================
# FRONTEND: Shared access (PAT) mode
# ============================================================================
# Copy to .env.local in sample-app/
#
# Matches backend AUTH_MODE=PAT: no login page, no OAuth variables. All chat
# traffic is proxied through the backend, which uses the shared Snowflake PAT.
# ============================================================================

VITE_BACKEND_URL=http://localhost:3001
VITE_AUTH_MODE=PAT
