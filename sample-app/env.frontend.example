# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Copy this file to .env.local in the sample-app/ directory
# This file contains ONLY public configuration - NO sensitive credentials!
#
# Vite exposes variables prefixed with VITE_ to the browser via import.meta.env
# ============================================================================

# Backend Proxy Server URL (REQUIRED)
# In development: point to local backend
VITE_BACKEND_URL=http://localhost:3001

# In production: point to your deployed backend
# Example: VITE_BACKEND_URL=https://api.yourapp.ai

# ============================================================================
# APPLICATION CONFIGURATION (OPTIONAL)
# ============================================================================
# Application name used for thread tracking and grouping conversations
# This helps identify which application created threads in Snowflake
# Default: ask_cortex
VITE_APPLICATION_NAME=ask_cortex

# ============================================================================
# AUTHENTICATION MODE (REQUIRED)
# ============================================================================
# Must match the AUTH_MODE set in your backend .env
# - PAT: No login page, immediate access
# - OAUTH: Users must login via Identity Provider
# Default: OAUTH

VITE_AUTH_MODE=OAUTH

# ============================================================================
# OAUTH CONFIGURATION (Required only for OAUTH mode)
# ============================================================================
# The app constructs the full authorization URL from these components
# and generates a random `state` parameter on each login attempt.
#
# Only required when VITE_AUTH_MODE=OAUTH

# OAuth Authorization Endpoint (base URL, no query parameters)
# Format: https://idp.example.com/oauth/authorize
VITE_OAUTH_LOGIN_URL=https://your-idp.example.com/oauth/authorize

# OAuth Client ID - public identifier for your application
VITE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID

# OAuth Redirect URI - where the IdP redirects after authentication
# Must match the redirect_uri registered with your OAuth provider
# In development: http://localhost:3000/auth/callback
# In production: https://yourapp.com/auth/callback
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# OAuth Response Type (optional, defaults to "code")
# VITE_OAUTH_RESPONSE_TYPE=code

# OAuth Scope (optional, omitted from URL if not set)
# Include "openid" to receive an id_token from the IdP (required for HYBRID mode)
# Example: openid profile email, or session:role-any
# VITE_OAUTH_SCOPE=openid profile email

# OAuth Audience (optional, omitted from URL if not set)
# Required by some IdPs (e.g., Auth0) to return a JWT access_token instead of opaque.
# Should match the IDP_AUDIENCE configured on the backend.
# VITE_OAUTH_AUDIENCE=https://your-api-identifier

# OAuth Prompt (optional, omitted from URL if not set)
# Controls whether the IdP forces re-authentication or shows a consent screen.
# This is the OIDC standard "prompt" parameter. Common values:
#   login    - Always show the login screen (useful for dev/test to switch users)
#   consent  - Always show the consent screen
#   none     - Never show UI; fail silently if the user isn't already authenticated
# In production, leave unset so that existing IdP sessions are reused seamlessly.
# In development, set to "login" to easily test with multiple IdP accounts.
# VITE_OAUTH_PROMPT=login

# ============================================================================
# SECURITY NOTES
# ============================================================================
# ✅ Frontend ONLY needs the backend URL and auth configuration
# ✅ NO access tokens or refresh tokens in frontend environment
# ✅ NO Snowflake credentials in frontend
# ✅ All API calls go through the secure backend proxy
# ✅ Tokens managed server-side with httpOnly cookies
# ✅ OAuth client secrets never exposed to browser
#
# For PAT mode:
#   - Set VITE_AUTH_MODE=PAT
#   - OAuth variables are not needed
#   - No login page - users access the app directly
#   - No logout button shown
#
# For OAUTH mode (also used for backend HYBRID mode):
#   - Set VITE_AUTH_MODE=OAUTH
#   - Provide VITE_OAUTH_LOGIN_URL, VITE_OAUTH_CLIENT_ID, VITE_OAUTH_REDIRECT_URI
#   - Optionally set VITE_OAUTH_RESPONSE_TYPE and VITE_OAUTH_SCOPE
#   - Users see login page and must authenticate
#   - Logout button appears in header
#   - A random `state` parameter is generated on each login for CSRF protection
# ============================================================================
