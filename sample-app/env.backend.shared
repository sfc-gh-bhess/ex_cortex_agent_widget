# ============================================================================
# BACKEND: Shared access (PAT) mode
# ============================================================================
# Copy to .env in sample-app/
#
# No Identity Provider or per-user login. A single Snowflake Personal Access
# Token on the server is used for all Cortex API calls. Everyone who can reach
# the app shares the same Snowflake identity and access — use only for demos,
# prototypes, or strictly trusted internal networks.
# ============================================================================

SERVER_PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

AUTH_MODE=PAT

# Thread tagging — up to 16 characters in PAT mode
ORIGIN_APPLICATION=ask_crtx

# Snowflake
SNOWFLAKE_HOST=your_account.snowflakecomputing.com
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema

# Personal Access Token (server-side only — never expose to the browser)
SNOWFLAKE_PAT=your_personal_access_token
