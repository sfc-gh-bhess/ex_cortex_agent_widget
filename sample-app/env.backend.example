# ============================================================================
# BACKEND SERVER CONFIGURATION
# ============================================================================
# Copy this file to .env in the sample-app/ directory
# This file contains sensitive credentials - DO NOT commit to git!
# ============================================================================

# Server Configuration
SERVER_PORT=3001
NODE_ENV=development

# CORS Configuration
# In development: allow localhost
# In production: set to your actual frontend domain(s), comma-separated
# Example: ALLOWED_ORIGINS=https://yourapp.ai,https://www.yourapp.ai
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# AUTHENTICATION MODE (REQUIRED)
# ============================================================================
# Choose between PAT, OAUTH, or HYBRID authentication
# - PAT: All users share a single Snowflake PAT token (simpler setup)
# - OAUTH: Each user authenticates via Identity Provider and gets their own
#           Snowflake access token (more secure, per-user auth)
# - HYBRID: Users authenticate via Identity Provider (for app access and tenant
#           identification), but all Snowflake API calls use a shared service PAT.
#           A claim from the IdP JWT identifies the tenant. Tenant isolation is
#           enforced via session variables (Row Access Policy) or per-tenant
#           Snowflake roles (X-Snowflake-Role header). See TENANT_ISOLATION_MODE.
# Default: OAUTH

AUTH_MODE=OAUTH

# ============================================================================
# APPLICATION IDENTITY
# ============================================================================
# Base name used to tag and filter threads in Snowflake.
# Snowflake limits origin_application to 16 bytes.
#
# In HYBRID mode, a 7-char hash of the user's identity is appended
# automatically (e.g., ask_crtx_a1b2c3d) to scope threads per-user.
# This means the base value must be at most 8 characters (8 base + 1
# underscore + 7 hash = 16).
#
# In PAT/OAUTH modes the full 16 characters are available.
# Default: ask_crtx
ORIGIN_APPLICATION=ask_crtx

# ============================================================================
# SNOWFLAKE CONFIGURATION
# ============================================================================

# Your Snowflake host (format: accountname.snowflakecomputing.com)
SNOWFLAKE_HOST=your_account.snowflakecomputing.com

# Database and Schema for Cortex Agents
SNOWFLAKE_DATABASE=snowflake_intelligence
SNOWFLAKE_SCHEMA=agents

# Snowflake warehouse for SQL API (sales chart, tenant role table in HYBRID ROLE, etc.)
# Required when AUTH_MODE=PAT or HYBRID. Optional when AUTH_MODE=OAUTH (uses user default if unset).
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Snowflake role used for administrative SQL API queries (e.g., reading the tenant role table)
# Optional -- if not set, the default role for the PAT user is used.
# This is NOT the per-tenant role; it is the role the server uses to READ the tenant mapping table.
# SNOWFLAKE_ROLE=SYSADMIN

# Note: All API endpoints (agents list, agent details, and agent messaging)
# are built automatically from the SNOWFLAKE_HOST, DATABASE, and SCHEMA above

# ============================================================================
# OPTION 1: PAT MODE CONFIGURATION
# ============================================================================
# Required when AUTH_MODE=PAT
# Snowflake Personal Access Token - used for all API requests
# This token is kept secure on the server and never exposed to the browser
# SNOWFLAKE_PAT=your_personal_access_token_here
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# ============================================================================
# OPTION 2: OAUTH MODE CONFIGURATION
# ============================================================================
# Required when AUTH_MODE=OAUTH
# OAuth is used for authenticating users and obtaining access tokens for Snowflake
# These credentials are provided by your Identity Provider (e.g., Okta, Auth0, etc.)

# OAuth Token URL - endpoint to exchange authorization code for access tokens
# Format: https://idp.example.com/oauth/token
OAUTH_TOKEN_URL=https://your-idp.example.com/oauth/token

# OAuth Client ID - public identifier for your application
OAUTH_CLIENT_ID=your_client_id_here

# OAuth Client Secret - SECRET credential for your application (DO NOT SHARE)
OAUTH_CLIENT_SECRET=your_client_secret_here

# OAuth Redirect URI - where the Identity Provider redirects after authentication
# MUST match the redirect_uri registered with your OAuth provider
# In development: http://localhost:3000/auth/callback
# In production: https://yourapp.com/auth/callback
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================================================
# OPTION 3: HYBRID MODE CONFIGURATION
# ============================================================================
# Required when AUTH_MODE=HYBRID
# Users authenticate via an Identity Provider (same OAuth flow as OAUTH mode),
# but Snowflake API calls use a shared PAT. A claim from the IdP JWT identifies
# the tenant. How tenant data isolation is enforced depends on TENANT_ISOLATION_MODE:
#
#   SESSION_VAR (default): The tenant claim is injected as a session variable
#     in Cortex Agent requests, used with Snowflake Row Access Policies.
#   ROLE: The tenant claim is mapped to a Snowflake role (via a lookup table)
#     and set via the X-Snowflake-Role header on all Snowflake API calls.
#
# Requires ALL of:
#   - SNOWFLAKE_PAT (shared service PAT for Snowflake API calls)
#   - OAuth configuration (TOKEN_URL, CLIENT_ID, CLIENT_SECRET, REDIRECT_URI)
#   - IdP JWT validation settings (JWKS URL, issuer)
#   - CLAIM_KEY (which JWT claim holds the tenant identifier)
#   - For SESSION_VAR: SESSION_VAR_NAME, SNOWFLAKE_WAREHOUSE
#   - For ROLE: TENANT_ROLE_TABLE, SNOWFLAKE_WAREHOUSE

# IdP JWKS URL - endpoint to fetch JSON Web Key Set for JWT validation
# Format: https://idp.example.com/.well-known/jwks.json
# IDP_JWKS_URL=https://your-idp.example.com/oauth2/your-auth-server/v1/keys

# IdP Issuer - expected "iss" claim in the JWT
# IDP_ISSUER=https://your-idp.example.com/oauth2/your-auth-server

# IdP Audience - expected "aud" claim in the JWT (optional)
# If not set, OAUTH_CLIENT_ID is used (which matches the id_token's aud for all
# OIDC-compliant IdPs). Only set this if your IdP uses a different audience value.
# IDP_AUDIENCE=your_audience_here

# Session Variable Name - the variable name passed to the Cortex Agent
# This becomes a session variable in the Snowflake query context
# Example: TENANT, ORGANIZATION, DEPARTMENT
# SESSION_VAR_NAME=TENANT

# Claim Key - the field in the IdP JWT claims that contains the tenant value
# Example: tenant, org_id, email, custom_claim, etc.
# CLAIM_KEY=tenant

# Username Claim Key - the IdP JWT claim used to identify the logged-in user
# A 7-character SHA-256 hash of this claim's value is appended to
# ORIGIN_APPLICATION to scope threads per-user (e.g., ask_crtx_a1b2c3d).
# Default: email
# USERNAME_CLAIM_KEY=email

# Tenant Isolation Mode - how tenant data access is enforced
# SESSION_VAR (default): inject tenant as a session variable (Row Access Policy)
# ROLE: map tenant to a Snowflake role via lookup table (X-Snowflake-Role header)
# TENANT_ISOLATION_MODE=SESSION_VAR

# --- Required when TENANT_ISOLATION_MODE=ROLE ---

# Fully-qualified Snowflake table containing tenant-to-role mappings
# Table must have columns: tenant_key VARCHAR, tenant_role VARCHAR
# Create with:
#   CREATE TABLE MYDB.MYSCHEMA.TENANT_ROLES (
#     tenant_key VARCHAR NOT NULL,
#     tenant_role VARCHAR NOT NULL
#   );
#   INSERT INTO MYDB.MYSCHEMA.TENANT_ROLES VALUES ('acme', 'TENANT_ACME');
# TENANT_ROLE_TABLE=MYDB.MYSCHEMA.TENANT_ROLES

# How often (in seconds) to refresh the tenant-role cache from Snowflake
# Default: 300 (5 minutes). Set to 0 to disable periodic refresh.
# On cache miss (new tenant), the table is re-fetched immediately regardless of TTL.
# TENANT_ROLE_CACHE_TTL_SECS=300

# ============================================================================
# CONFIGURATION NOTES
# ============================================================================
# For PAT mode:
#   - Set AUTH_MODE=PAT
#   - Provide SNOWFLAKE_PAT
#   - OAuth variables are not needed
#   - No login page - users access the app directly
#   - All users share the same Snowflake credentials
#
# For OAUTH mode:
#   - Set AUTH_MODE=OAUTH
#   - Provide OAuth configuration (TOKEN_URL, CLIENT_ID, CLIENT_SECRET, REDIRECT_URI)
#   - SNOWFLAKE_PAT is not needed
#   - Users authenticate via Identity Provider
#   - Each user has their own access token
#   - Tokens are automatically refreshed when they expire
#
# For HYBRID mode (SESSION_VAR isolation — default):
#   - Set AUTH_MODE=HYBRID
#   - Provide SNOWFLAKE_PAT (shared service account PAT for all Snowflake calls)
#   - Provide OAuth configuration (TOKEN_URL, CLIENT_ID, CLIENT_SECRET, REDIRECT_URI)
#   - Provide IdP JWT settings (IDP_JWKS_URL, IDP_ISSUER)
#   - Provide session variable mapping (SESSION_VAR_NAME, CLAIM_KEY)
#   - Users authenticate via Identity Provider (same login flow as OAUTH)
#   - The frontend uses VITE_AUTH_MODE=OAUTH (no separate HYBRID frontend mode)
#   - Backend validates the IdP JWT and extracts the tenant from claims
#   - Tenant value is injected as a session variable in Cortex Agent API calls
#   - Data filtered per-tenant via Snowflake Row Access Policies
#
# For HYBRID mode (ROLE isolation):
#   - Set AUTH_MODE=HYBRID and TENANT_ISOLATION_MODE=ROLE
#   - Provide SNOWFLAKE_PAT, OAuth config, and IdP JWT settings (same as above)
#   - Provide CLAIM_KEY (which JWT claim holds the tenant identifier)
#   - Provide TENANT_ROLE_TABLE (fully-qualified Snowflake table with mappings)
#   - Provide SNOWFLAKE_WAREHOUSE (required for SQL API queries)
#   - Optionally provide SNOWFLAKE_ROLE (role used to read the mapping table)
#   - Tenant claim is mapped to a Snowflake role via the lookup table
#   - The resolved role is set via X-Snowflake-Role header on all Snowflake API calls
#   - Data access controlled by Snowflake RBAC grants on the tenant role
#   - Onboard new tenants by inserting rows — no server restart needed
# ============================================================================

