# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Copy this file to .env.local in the project root
# This file contains ONLY public configuration - NO sensitive credentials!
# ============================================================================

# Backend Proxy Server URL (REQUIRED)
# In development: point to local backend
REACT_APP_BACKEND_URL=http://localhost:3001

# In production: point to your deployed backend
# Example: REACT_APP_BACKEND_URL=https://api.yourapp.ai

# ============================================================================
# AUTHENTICATION MODE (REQUIRED)
# ============================================================================
# Must match the AUTH_MODE set in your backend .env
# - PAT: No login page, immediate access
# - OAUTH: Users must login via Identity Provider
# Default: OAUTH

REACT_APP_AUTH_MODE=OAUTH

# ============================================================================
# OAUTH CONFIGURATION (Required only for OAUTH mode)
# ============================================================================
# OAuth Login URL (provided by your Identity Provider)
# This should include the authorization endpoint with client_id, redirect_uri, response_type, and state
# Format: https://idp.example.com/oauth/authorize?client_id=YOUR_CLIENT_ID&redirect_uri=http://localhost:3000/auth/callback&response_type=code&state=RANDOM_STATE
# 
# Only required when REACT_APP_AUTH_MODE=OAUTH
REACT_APP_OAUTH_LOGIN_URL=https://your-idp.example.com/oauth/authorize?client_id=YOUR_CLIENT_ID&redirect_uri=http://localhost:3000/auth/callback&response_type=code&state=RANDOM_STATE

# ============================================================================
# SECURITY NOTES
# ============================================================================
# ✅ Frontend ONLY needs the backend URL and auth configuration
# ✅ NO access tokens or refresh tokens in frontend environment
# ✅ NO Snowflake credentials in frontend
# ✅ All API calls go through the secure backend proxy
# ✅ Tokens managed server-side with httpOnly cookies
# ✅ OAuth client secrets never exposed to browser
#
# For PAT mode:
#   - Set REACT_APP_AUTH_MODE=PAT
#   - REACT_APP_OAUTH_LOGIN_URL is not needed
#   - No login page - users access the app directly
#   - No logout button shown
#
# For OAUTH mode:
#   - Set REACT_APP_AUTH_MODE=OAUTH
#   - Provide REACT_APP_OAUTH_LOGIN_URL
#   - Users see login page and must authenticate
#   - Logout button appears in header
# ============================================================================

