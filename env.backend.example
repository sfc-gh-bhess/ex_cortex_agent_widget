# ============================================================================
# BACKEND SERVER CONFIGURATION
# ============================================================================
# Copy this file to .env in the project root
# This file contains sensitive credentials - DO NOT commit to git!
#
# See also:
#   - env.v1.example - Example for v1 API mode
#   - env.v2.example - Example for v2 API mode (standard)
#   - env.v2.inline.example - Example for v2 with inline spec
#   - env.hybrid.example - Example for hybrid PAT-OAUTH mode (v1)
# ============================================================================

# Server Configuration
SERVER_PORT=3001
NODE_ENV=development

# CORS Configuration
# In development: allow localhost
# In production: set to your actual frontend domain(s), comma-separated
# Example: ALLOWED_ORIGINS=https://yourapp.ai,https://www.yourapp.ai
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# API VERSION SELECTION
# ============================================================================
# Choose which Cortex Agent API version to use
# - v1: Requires inline spec, executes SQL, translates events to v2 format
# - v2: Standard mode with Snowflake agent registry and threading (default)
# Default: v2

AGENT_API_VERSION=v2

# ============================================================================
# FIXED AGENT MODE (Optional)
# ============================================================================
# Restrict the application to use only one specific agent
# When set, the agent list will only return this agent
# FIXED_AGENT_NAME=my_sales_agent

# ============================================================================
# INLINE AGENT SPECIFICATION (Optional)
# ============================================================================
# Provide agent specification via a JSON file instead of querying Snowflake
# Required for v1 mode, optional for v2 mode
# When used, FIXED_AGENT_NAME must also be set
# AGENT_SPEC_FILE=./agent_config.json

# ============================================================================
# AUTHENTICATION MODE (REQUIRED)
# ============================================================================
# Choose between PAT (Personal Access Token) or OAUTH authentication
# - PAT: All users share a single Snowflake PAT token (simpler setup)
# - OAUTH: Each user authenticates via Identity Provider (more secure, per-user auth)
# Default: OAUTH

AUTH_MODE=OAUTH

# ============================================================================
# SNOWFLAKE CONFIGURATION
# ============================================================================

# Your Snowflake host (format: accountname.snowflakecomputing.com)
SNOWFLAKE_HOST=your_account.snowflakecomputing.com

# Database and Schema for Cortex Agents
SNOWFLAKE_DATABASE=snowflake_intelligence
SNOWFLAKE_SCHEMA=agents

# Note: All API endpoints (agents list, agent details, and agent messaging)
# are built automatically from the SNOWFLAKE_HOST, DATABASE, and SCHEMA above

# ============================================================================
# OPTION 1: PAT MODE CONFIGURATION
# ============================================================================
# Required when AUTH_MODE=PAT
# Snowflake Personal Access Token - used for all API requests
# This token is kept secure on the server and never exposed to the browser
# SNOWFLAKE_PAT=your_personal_access_token_here

# ============================================================================
# OPTION 2: OAUTH MODE CONFIGURATION
# ============================================================================
# Required when AUTH_MODE=OAUTH
# OAuth is used for authenticating users and obtaining access tokens for Snowflake
# These credentials are provided by your Identity Provider (e.g., Okta, Auth0, etc.)

# OAuth Token URL - endpoint to exchange authorization code for access tokens
# Format: https://idp.example.com/oauth/token
OAUTH_TOKEN_URL=https://your-idp.example.com/oauth/token

# OAuth Client ID - public identifier for your application
OAUTH_CLIENT_ID=your_client_id_here

# OAuth Client Secret - SECRET credential for your application (DO NOT SHARE)
OAUTH_CLIENT_SECRET=your_client_secret_here

# OAuth Redirect URI - where the Identity Provider redirects after authentication
# MUST match the redirect_uri registered with your OAuth provider
# In development: http://localhost:3000/auth/callback
# In production: https://yourapp.com/auth/callback
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================================================
# OAUTH CLAIMS EXTRACTION (Optional - for hybrid mode)
# ============================================================================
# Configure JWT validation to extract claims from OAuth tokens
# Used for hybrid PAT-OAUTH mode or when you need user information server-side

# JWKS URL - endpoint for JWT public keys
# IDP_JWKS_URL=https://your-idp.example.com/.well-known/jwks.json

# Issuer - expected issuer in JWT tokens
# IDP_ISSUER=https://your-idp.example.com

# Audience - expected audience in JWT tokens
# IDP_AUDIENCE=your_client_id_here

# ============================================================================
# v1 MODE CONFIGURATION (Required when AGENT_API_VERSION=v1)
# ============================================================================
# v1 mode requires SQL execution capabilities

# Snowflake Warehouse - used for executing SQL queries in v1 mode
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# ============================================================================
# HYBRID PAT-OAUTH MODE (Optional - v1 only)
# ============================================================================
# Use a single PAT for Snowflake but set session variables from OAuth claims
# Useful for row-level security in multi-tenant applications
#
# Hybrid mode is automatically detected when:
#   - AUTH_MODE=OAUTH (users log in via OAuth)
#   - SESSION_VAR_NAME is set (indicates we want session variables)
#   - SNOWFLAKE_PAT is set (used for all Snowflake API calls)
#
# In this mode:
#   - Users authenticate via OAuth (login flow, JWT validation)
#   - Snowflake API calls use the shared PAT (not individual OAuth tokens)
#   - Claims are extracted from OAuth tokens
#   - Session variables are set before SQL execution using claim values
#
# Configuration:
# SNOWFLAKE_PAT=your_shared_pat_token

# Session Variable Name - Snowflake session variable to set before SQL execution
# Example: TENANT, USER_ID, ORG_ID, etc.
# SESSION_VAR_NAME=TENANT

# Claim Key - which OAuth claim to use as the session variable value
# Common values: email, sub, preferred_username, org_id
# Default: email
# CLAIM_KEY=email

# ============================================================================
# CONFIGURATION NOTES
# ============================================================================
# For PAT mode:
#   - Set AUTH_MODE=PAT
#   - Provide SNOWFLAKE_PAT
#   - OAuth variables are not needed
#   - No login page - users access the app directly
#   - All users share the same Snowflake credentials
#
# For OAUTH mode:
#   - Set AUTH_MODE=OAUTH
#   - Provide OAuth configuration (TOKEN_URL, CLIENT_ID, CLIENT_SECRET, REDIRECT_URI)
#   - SNOWFLAKE_PAT is not needed
#   - Users authenticate via Identity Provider
#   - Each user has their own access token
#   - Tokens are automatically refreshed when they expire
# ============================================================================

