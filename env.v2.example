# ============================================================================
# v2 MODE CONFIGURATION EXAMPLE (Standard)
# ============================================================================
# This is the standard v2 configuration that queries Snowflake for available agents.
# This is the default mode and requires no additional configuration beyond the basics.
#
# Copy to .env and customize for your environment
# ============================================================================

# Server Configuration
SERVER_PORT=3001
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# API VERSION (Optional - defaults to v2)
# ============================================================================
# AGENT_API_VERSION=v2

# ============================================================================
# SNOWFLAKE CONFIGURATION
# ============================================================================
SNOWFLAKE_HOST=your_account.snowflakecomputing.com
SNOWFLAKE_DATABASE=snowflake_intelligence
SNOWFLAKE_SCHEMA=agents

# ============================================================================
# AUTHENTICATION MODE
# ============================================================================
# Choose PAT or OAUTH
AUTH_MODE=OAUTH

# ============================================================================
# PAT MODE (if AUTH_MODE=PAT)
# ============================================================================
# SNOWFLAKE_PAT=your_personal_access_token

# ============================================================================
# OAUTH MODE (if AUTH_MODE=OAUTH)
# ============================================================================
OAUTH_TOKEN_URL=https://your-idp.com/oauth/token
OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Optional: JWT validation for OAuth claims extraction
# IDP_JWKS_URL=https://your-idp.com/.well-known/jwks.json
# IDP_ISSUER=https://your-idp.com
# IDP_AUDIENCE=your_audience

