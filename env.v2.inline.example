# ============================================================================
# v2 MODE WITH INLINE SPECIFICATION EXAMPLE
# ============================================================================
# This configuration uses v2 API but with an inline agent specification file.
# Useful when you want to use a custom agent definition with v2 features.
#
# Copy to .env and customize for your environment
# ============================================================================

# Server Configuration
SERVER_PORT=3001
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# API VERSION (Optional - defaults to v2)
# ============================================================================
AGENT_API_VERSION=v2

# ============================================================================
# FIXED AGENT & INLINE SPECIFICATION
# ============================================================================
# When using inline spec, you must also specify the fixed agent name
FIXED_AGENT_NAME=my_custom_agent
AGENT_SPEC_FILE=./agent_config.json

# ============================================================================
# SNOWFLAKE CONFIGURATION
# ============================================================================
SNOWFLAKE_HOST=your_account.snowflakecomputing.com
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema

# ============================================================================
# AUTHENTICATION MODE
# ============================================================================
AUTH_MODE=PAT

# PAT Mode: Provide your Personal Access Token
SNOWFLAKE_PAT=your_personal_access_token

# ============================================================================
# OAUTH MODE (Alternative)
# ============================================================================
# AUTH_MODE=OAUTH
# OAUTH_TOKEN_URL=https://your-idp.com/oauth/token
# OAUTH_CLIENT_ID=your_client_id
# OAUTH_CLIENT_SECRET=your_client_secret
# OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

