# ============================================================================
# v1 MODE CONFIGURATION EXAMPLE
# ============================================================================
# This configuration is for using Cortex Agent API v1 with inline specification
# and in-memory thread management.
#
# Copy to .env and customize for your environment
# ============================================================================

# Server Configuration
SERVER_PORT=3001
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# API VERSION (REQUIRED for v1)
# ============================================================================
AGENT_API_VERSION=v1

# ============================================================================
# FIXED AGENT & INLINE SPECIFICATION (REQUIRED for v1)
# ============================================================================
# v1 requires both a fixed agent name and inline specification file
FIXED_AGENT_NAME=my_sales_agent
AGENT_SPEC_FILE=./agent_config.json

# ============================================================================
# SNOWFLAKE CONFIGURATION
# ============================================================================
SNOWFLAKE_HOST=your_account.snowflakecomputing.com
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema

# Warehouse (REQUIRED for v1 - used for SQL execution)
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# ============================================================================
# AUTHENTICATION MODE
# ============================================================================
AUTH_MODE=PAT

# PAT Mode: Provide your Personal Access Token
SNOWFLAKE_PAT=your_personal_access_token

# ============================================================================
# OPTIONAL: HYBRID PAT-OAUTH MODE (v1 only)
# ============================================================================
# Use a single PAT but set session variables based on OAuth claims
# Uncomment and configure if you want row-level security in v1 mode
#
# SESSION_VAR_NAME=TENANT
# CLAIM_KEY=email
#
# Also enable OAuth and JWT validation:
# AUTH_MODE=OAUTH
# OAUTH_TOKEN_URL=https://your-idp.com/oauth/token
# OAUTH_CLIENT_ID=your_client_id
# OAUTH_CLIENT_SECRET=your_client_secret
# OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# IDP_JWKS_URL=https://your-idp.com/.well-known/jwks.json
# IDP_ISSUER=https://your-idp.com
# IDP_AUDIENCE=your_audience

