# ============================================================================
# HYBRID PAT-OAUTH MODE CONFIGURATION EXAMPLE (v1 only)
# ============================================================================
# This configuration uses a single PAT token for Snowflake access, but sets
# session variables based on OAuth claims for row-level security.
#
# Hybrid mode is automatically detected when:
#   AUTH_MODE=OAUTH + SESSION_VAR_NAME is set + SNOWFLAKE_PAT is set
#
# Use case: Multi-tenant applications where:
# - All users share the same Snowflake PAT (for API calls)
# - Users authenticate via OAuth (for identity)
# - Each user has different data access based on session variables
# - Session variables are set from OAuth claims before SQL execution
#
# Copy to .env and customize for your environment
# ============================================================================

# Server Configuration
SERVER_PORT=3001
NODE_ENV=development

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# API VERSION (REQUIRED - v1 only)
# ============================================================================
AGENT_API_VERSION=v1

# ============================================================================
# FIXED AGENT & INLINE SPECIFICATION (REQUIRED for v1)
# ============================================================================
FIXED_AGENT_NAME=my_multitenant_agent
AGENT_SPEC_FILE=./agent_config.json

# ============================================================================
# SNOWFLAKE CONFIGURATION
# ============================================================================
SNOWFLAKE_HOST=your_account.snowflakecomputing.com
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# ============================================================================
# HYBRID MODE: PAT with OAuth Claims
# ============================================================================
# Use a single PAT for all Snowflake access
SNOWFLAKE_PAT=your_personal_access_token

# But authenticate users via OAuth
AUTH_MODE=OAUTH
OAUTH_TOKEN_URL=https://your-idp.com/oauth/token
OAUTH_CLIENT_ID=your_client_id
OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================================================
# JWT VALIDATION (REQUIRED for claims extraction)
# ============================================================================
# Configure JWT validation to extract OAuth claims
IDP_JWKS_URL=https://your-idp.com/.well-known/jwks.json
IDP_ISSUER=https://your-idp.com
IDP_AUDIENCE=your_audience

# ============================================================================
# SESSION VARIABLE CONFIGURATION
# ============================================================================
# Set a Snowflake session variable before each SQL execution
# The value comes from the OAuth claims
#
# Example: If CLAIM_KEY=email and the user's email is john@acme.com,
# then before executing SQL, we run:
#   ALTER SESSION SET TENANT='john@acme.com';
#
# Your semantic model or views should then filter data based on this variable.

SESSION_VAR_NAME=TENANT
CLAIM_KEY=email

# Alternative claim keys you might use:
# CLAIM_KEY=sub                    # User ID
# CLAIM_KEY=preferred_username     # Username
# CLAIM_KEY=org_id                 # Organization ID
# CLAIM_KEY=department             # Department name

